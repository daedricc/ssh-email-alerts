# Resend example; another TLS-enabled SMTP provider can also be used.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=SSH Alerts <alerts@example.com>
# Multiple recipients: you@example.com,team@example.com
EMAIL_TO=you@example.com
# auto: SSL on port 465, STARTTLS on other ports; or ssl / starttls
SMTP_SECURITY=auto
SENDER_NAME=SSH Alerts
# en or tr
LANGUAGE=en
# IANA timezone, e.g. Europe/Istanbul, Europe/Berlin, America/New_York
TIMEZONE=UTC
# Positive integer values (1–86400); times are in seconds.
POLL_INTERVAL=15
FAILURE_WINDOW=600
FAILURE_THRESHOLD=5
ALERT_COOLDOWN=600
